# Copy to .env.local for a local test environment, or set these in Vercel.
# Never paste actual credentials into chat or commit populated environment files.
# Use an isolated staging cluster before running persistence QA.
MONGODB_URI=
# Generate cryptographically random values of at least 32 characters.
ADMIN_SECRET=
CUSTOMER_SESSION_SECRET=
# Existing data/admin-config.json passwordHash takes precedence in the current login.
# Configure an owner-approved admin credential; do not assume this overrides a stored hash.
ADMIN_PASSWORD=
NEXT_PUBLIC_GA4_ID=G-MSXWFZ24ES
GOOGLE_SITE_VERIFICATION=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternative: a valid cloudinary:// URL; never use a NEXT_PUBLIC variable for secrets.
CLOUDINARY_URL=
# Optional unsigned preset only if explicitly approved by the account owner.
CLOUDINARY_UPLOAD_PRESET=
# Optional, explicit read-only staging validation. Must use a separate cluster.
STAGING_MONGODB_URI=
